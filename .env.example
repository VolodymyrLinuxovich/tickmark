# Claude request parser (optional; keyword parser is used without it)
ANTHROPIC_API_KEY=

# OpenAI request parser, tried after Claude (optional)
OPENAI_API_KEY=
# Defaults to gpt-5.5
OPENAI_MODEL=

# fixture (default) | sandbox | production
TICKMARK_SOURCE=fixture
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=

# claude | openai | rules picks one parser; empty tries Claude, then OpenAI, then rules
TICKMARK_PARSER=
