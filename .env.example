# Claude request parser (optional; keyword parser is used without it)
ANTHROPIC_API_KEY=

# OpenAI request parser, tried after Claude (optional)
OPENAI_API_KEY=
# Defaults to gpt-5.5
OPENAI_MODEL=

# auto (default) | sandbox | production | sample; auto uses Ramp when credentials are found, else sample data
TICKMARK_SOURCE=
# Ramp developer app credentials (checked first)
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Ramp access token, used when the client ID and secret are not set
RAMP_ACCESS_TOKEN=
# sandbox (default) | production
RAMP_ENV=
# Overrides the Ramp API base URL, e.g. the mock server from npm run mock:ramp
RAMP_API_BASE_URL=

# claude | openai | rules picks one parser; model makes a model read first; empty tries Claude, then OpenAI, then rules
TICKMARK_PARSER=
# Any value logs OpenAI token usage per parse
TICKMARK_LOG_USAGE=

# Card purchases above this many dollars need pre-approval (default 5000)
TICKMARK_CARD_APPROVAL_LIMIT=
# Receipts are required at this many dollars and above (default 75)
TICKMARK_RECEIPT_THRESHOLD=

# Vercel Blob token for auditor portal storage; without it portals live in memory
BLOB_READ_WRITE_TOKEN=
